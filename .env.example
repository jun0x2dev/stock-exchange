# .env로 복사한 뒤 값을 채운다. .env는 커밋하지 않는다.
POSTGRES_PASSWORD=
# 애플리케이션 전용 DB 계정의 비밀번호. 영문, 숫자, _, -로 16자 이상.
EXCHANGE_DB_APP_PASSWORD=
# 감사 로그 체인의 키. openssl rand -base64 32 로 만든다. 바꾸면 이전 기록을 검증할 수 없다.
EXCHANGE_AUDIT_KEY=
# 값을 채우면 기동할 때 체험용 사용자(demo, maker, taker, operator, approver, auditor)와 호가를 만든다. 로컬에서만 쓴다.
EXCHANGE_DEMO_PASSWORD=
# 8080을 다른 프로그램이 쓸 때만 채운다. Docker로 전체를 띄울 때의 접속 포트다.
CORE_PORT=
